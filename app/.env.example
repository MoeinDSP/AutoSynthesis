# Copy to .env and fill in. Only OPENROUTER_API_KEY is required; everything else is optional.

# ── LLM (all agents call models through OpenRouter) ──────────────────────────
OPENROUTER_API_KEY=
MODEL_NAME=openai/gpt-5.6-sol            # or google/gemini-3.8-flash, anthropic/claude-opus-5

# ── Web app ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me                 # any long random string
POSTGRES_PASSWORD=change-me

# ── Literature search (optional; each source is skipped when its key is empty) ─
ENABLED_SEARCH_DATABASES=deep_research,PubMed,SemanticScholar,arxiv,OSF,Elsevier,WOS
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
WOS_API_KEY=
OSF_TOKEN=
KEENABLE_API_KEY=
UNPAYWALL_EMAIL=                         # contact email required by the Unpaywall API

# ── PDF-to-text (optional; falls back to pypdf) ───────────────────────────────
MINERU_API_KEY=
LLAMA_CLOUD_API_KEY=
